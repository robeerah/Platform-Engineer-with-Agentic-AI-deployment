# GENERATED by platformctl from platform.yaml. Do not edit by hand.
# Template owner: platform team (platform/templates/service.nomad.hcl.tpl)

job "{{service}}" {
  namespace   = "{{team}}"
  datacenters = ["*"]
  type        = "service"

  meta {
    team       = "{{team}}"
    managed_by = "platformctl"
    image      = "{{image}}"
  }

  group "app" {
    count = {{replicas}}

    network {
      port "http" {
        to = {{port}}
      }
    }

    # Rolling update, one instance at a time. A release whose health check
    # never passes is rolled back to the last good version automatically.
    update {
      max_parallel      = 1
      health_check      = "checks"
      min_healthy_time  = "10s"
      healthy_deadline  = "1m"
      progress_deadline = "2m"
      auto_revert       = true
    }

    restart {
      attempts = 3
      interval = "2m"
      delay    = "10s"
      mode     = "delay"
    }

    # Registering in Consul is what lets APISIX and Prometheus find this
    # service with no manual configuration.
    service {
      name     = "{{service}}"
      port     = "http"
      provider = "consul"
      tags     = ["team={{team}}", "metrics", "apisix"]

      meta {
        team         = "{{team}}"
        metrics_path = "{{metrics_path}}"
      }

      check {
        type     = "http"
        path     = "{{health_path}}"
        interval = "10s"
        timeout  = "2s"
      }
    }

    task "app" {
      driver = "docker"

      config {
        image      = "{{image}}"
        ports      = ["http"]
        force_pull = false
      }

      env {
        SERVICE_NAME = "{{service}}"
        TEAM         = "{{team}}"
{{env_lines}}
      }

      resources {
        cpu    = {{cpu}}
        memory = {{memory}}
      }
    }
  }
}
