    {
      "id": 7,
      "type": "timeseries",
      "title": "Gateway responses by status code",
      "description": "From the APISIX prometheus plugin. 429s here are the rate limiter working.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (code) (rate(apisix_http_status{route=~\"$service\"}[1m]))",
          "legendFormat": "{{code}}",
          "refId": "A"
